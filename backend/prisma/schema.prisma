// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DIRECT_URL")
  directUrl = env("DIRECT_URL")
}

enum OrganizationType {
  MANUFACTURER
  BRAND
  // Vendor types (2026-08-20 merge): BusinessPartner was folded into
  // Organization. Rows with these types always have ownerOrgId set, never
  // get OrganizationSubscription/Employee/OrgRelationship rows, and are
  // excluded from every "real tenant" org listing/lookup. See AGENTS.md.
  PROCESS_OUTSOURCING
  MATERIAL_SUPPLIER
}

enum OrgUserRole {
  ADMIN
  OPERATOR
  ACCOUNTANT
  WORKER
}

enum EmployeeStatus {
  PENDING
  ACTIVE
  REJECTED
  SUSPENDED
  TERMINATED

  @@map("OrgMembershipStatus")
}

enum OrganizationSubscriptionStatus {
  NOT_SUBSCRIBED
  TRIAL
  ACTIVE
  GRACE
  SUSPENDED
}

enum OnboardingRequestType {
  REGISTER_ORG
}

enum OnboardingRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum WorkOrderStatus {
  EDITING
  ORDER_RECEIVED
  IN_PROGRESS
  PRODUCTION_DONE
  SHIPPED
  SETTLED
}

enum WorkOrderConfirmationStatus {
  PLANNED
  CONFIRMED
}

enum WorkOrderItemGender {
  M
  W
  U
}

enum SalesPricingBasis {
  MANUFACTURING_SERVICE_PRICE
  FINISHED_GOODS_PRICE
}

enum SystemRole {
  SYSTEM_ADMIN
  USER
}

enum ProcessMasterOptionType {
  LOCATION
  PART
  TARGET
  TARGET_SPEC
  ACTION
  ACTION_SPEC
  SPEC
}

enum AssignmentCloseMode {
  FULL
  SHORT
  OVER
}

enum AssignmentCloseBasis {
  QC_BASED
  MANUAL
}

enum QcPassEventSourceType {
  MANUAL
  MIGRATED_LEGACY
}

model SystemUser {
  id                  Int        @id @default(autoincrement())
  email               String     @unique
  systemRole          SystemRole @default(USER)
  createdAt           DateTime   @default(now())
  createdBy           String     @default("system@baro.local")
  createdByEmployeeId Int?
  updatedByEmployeeId Int?
  updatedAt           DateTime   @updatedAt
  createdByEmployee   Employee?  @relation("SystemUserCreatedByEmployee", fields: [createdByEmployeeId], references: [id], onDelete: SetNull)
  updatedByEmployee   Employee?  @relation("SystemUserUpdatedByEmployee", fields: [updatedByEmployeeId], references: [id], onDelete: SetNull)
}

model ProcessMasterOption {
  id                  Int                           @id @default(autoincrement())
  type                ProcessMasterOptionType
  code                String
  label               String
  nameKo              String?
  nameEn              String?
  nameVi              String?
  sortOrder           Int                           @default(0)
  createdAt           DateTime                      @default(now())
  createdBy           String                        @default("system@baro.local")
  createdByEmployeeId Int?
  updatedByEmployeeId Int?
  updatedAt           DateTime                      @updatedAt
  parentRelations     ProcessMasterOptionRelation[] @relation("ProcessMasterOptionRelationParent")
  childRelations      ProcessMasterOptionRelation[] @relation("ProcessMasterOptionRelationChild")

  createdByEmployee Employee? @relation("ProcessMasterOptionCreatedByEmployee", fields: [createdByEmployeeId], references: [id], onDelete: SetNull)
  updatedByEmployee Employee? @relation("ProcessMasterOptionUpdatedByEmployee", fields: [updatedByEmployeeId], references: [id], onDelete: SetNull)

  @@unique([type, code])
  @@index([type, sortOrder, id])
}

model ProcessMasterOptionRelation {
  id             Int                 @id @default(autoincrement())
  type           String
  parentOptionId Int
  childOptionId  Int
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  parentOption   ProcessMasterOption @relation("ProcessMasterOptionRelationParent", fields: [parentOptionId], references: [id], onDelete: Cascade)
  childOption    ProcessMasterOption @relation("ProcessMasterOptionRelationChild", fields: [childOptionId], references: [id], onDelete: Cascade)

  @@unique([type, parentOptionId, childOptionId])
  @@index([parentOptionId])
  @@index([childOptionId])
}

model Organization {
  id                       Int              @id @default(autoincrement())
  name                     String
  nameKo                   String?
  nameVi                   String?
  code                     String?          @unique
  businessNumber           String?
  representative           String?
  representativeEmployeeId Int?
  industry                 String?
  address                  String?
  country                  String?
  countryCode              String?
  phone                    String?
  email                    String?
  defaultSizeSetCode       String           @default("LEGACY_APPAREL")
  targetMonthlyWage        Float?
  wagePerSecond            Float?
  type                     OrganizationType @default(MANUFACTURER)
  // Vendor-only fields (2026-08-20 merge). Real tenants (MANUFACTURER/BRAND)
  // always have isActive=true (ignored) and ownerOrgId=null. Vendor rows
  // (PROCESS_OUTSOURCING/MATERIAL_SUPPLIER) always have ownerOrgId set to
  // the manufacturer that registered them and never have a subscription,
  // employees, or OrgRelationship membership.
  isActive                 Boolean          @default(true)
  ownerOrgId               Int?
  salaryCurrencyId         Int?
  createdAt                DateTime         @default(now())
  createdBy                String           @default("system@baro.local")
  createdByEmployeeId      Int?
  updatedByEmployeeId      Int?
  updatedAt                DateTime         @updatedAt

  categories                      AttrCategory[]
  roles                           AttrRole[]
  processes                       AttrProcess[]
  subscription                    OrganizationSubscription?
  factories                       Factory[]
  factoryProductionAllowanceRates FactoryProductionAllowanceRate[]
  warehouses                      Warehouse[]
  employees                       Employee[]
  lines                           Line[]
  styles                          Style[]
  styleProcesses                  StyleProcess[]
  styleProcessVersions            StyleProcessVersion[]
  styleProcessStandards           StyleProcessStandard[]
  orders                          WorkOrder[]
  workLogs                        WorkLog[]
  workRecords                     WorkRecord[]
  outsourcedWorkRecords           OutsourcedWorkRecord[]
  vendorOutsourcedWorkRecords     OutsourcedWorkRecord[]            @relation("OutsourcedWorkRecordVendor")
  assignmentBoardState            AssignmentBoardState?
  assignmentCards                 AssignmentCard[]
  assignmentPlans                 AssignmentPlan[]
  buyerAssignmentCards            AssignmentCard[]                 @relation("AssignmentCardBuyerOrg")
  buyerAssignmentPlans            AssignmentPlan[]                 @relation("AssignmentPlanBuyerOrg")
  qcPassEvents                    QcPassEvent[]
  payrollSnapshots                PayrollSnapshot[]
  salaryItems                     SalaryItem[]
  salaryItemRates                 SalaryItemRate[]
  salarySystemVersions            SalarySystemVersion[]
  salaryCurrency                  Currency?                         @relation("OrganizationSalaryCurrency", fields: [salaryCurrencyId], references: [id], onDelete: Restrict)
  quantitySettlementSnapshots     QuantitySettlementSnapshot[]
  attendanceEntries               AttendanceEntry[]
  holidays                        OrganizationHoliday[]
  atTrainingBuckets               AtTrainingBucket[]
  atTrainingBucketProcesses       AtTrainingBucketProcess[]
  styleProcessAtObservations      StyleProcessAtObservation[]
  representativeEmployee          Employee?                        @relation("OrganizationRepresentative", fields: [representativeEmployeeId], references: [id], onDelete: SetNull)
  manufacturerRelationships       OrgRelationship[]                @relation("ManufacturerOrgRelationships")
  brandRelationships              OrgRelationship[]                @relation("BrandOrgRelationships")
  onboardingRequests              OnboardingRequest[]
  buyerWorkOrders                 WorkOrder[]                      @relation("WorkOrderBuyerOrg")
  sellerWorkOrders                WorkOrder[]                      @relation("WorkOrderSellerOrg")
  customerWorkOrders              WorkOrder[]                      @relation("WorkOrderCustomerOrg")
  quantityBucketSets              QuantityBucketSet[]
  quantityBucketSetVersions       QuantityBucketSetVersion[]
  quantityBucketEntries           QuantityBucketEntry[]
  employeeGradeSets               EmployeeGradeSet[]
  employeeGrades                  EmployeeGrade[]
  employeeCompensationPolicies    EmployeeCompensationPolicy[]
  employeePayTypePolicies         EmployeePayTypePolicy[]

  createdByEmployee Employee? @relation("OrganizationCreatedByEmployee", fields: [createdByEmployeeId], references: [id], onDelete: SetNull)
  updatedByEmployee Employee? @relation("OrganizationUpdatedByEmployee", fields: [updatedByEmployeeId], references: [id], onDelete: SetNull)

  // Vendor ownership (2026-08-20 merge, replaces BusinessPartner.orgId).
  owner   Organization?  @relation("OrganizationVendorOwner", fields: [ownerOrgId], references: [id], onDelete: Cascade)
  vendors Organization[] @relation("OrganizationVendorOwner")

  @@index([representativeEmployeeId])
  @@index([salaryCurrencyId])
  @@unique([ownerOrgId, type, name])
  @@index([ownerOrgId, type, isActive])
}

model Currency {
  id        Int      @id @default(autoincrement())
  code      String   @unique
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  salesPriceLists CustomerSalesPriceList[]
  defaultSalesRelationships OrgRelationship[] @relation("OrgRelationshipSalesCurrency")
  styleSalesCurrencyOverrides OrgRelationshipStyleSalesCurrency[]
  salaryOrganizations Organization[] @relation("OrganizationSalaryCurrency")
  salaryFactories Factory[] @relation("FactorySalaryCurrency")
}

model SystemSetting {
  key                 String    @id
  value               Json
  updatedBy           String?
  updatedByEmployeeId Int?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  updatedByEmployee   Employee? @relation("SystemSettingUpdatedByEmployee", fields: [updatedByEmployeeId], references: [id], onDelete: SetNull)
}

model OnboardingRequest {
  id                  Int                     @id @default(autoincrement())
  requesterEmail      String
  requestType         OnboardingRequestType   @default(REGISTER_ORG)
  organizationNameEn  String
  organizationType    OrganizationType        @default(MANUFACTURER)
  country             String                  @default("KR")
  companyAddress      String                  @default("")
  businessNumber      String
  contactName         String                  @default("")
  contactEmail        String
  contactPhone        String
  status              OnboardingRequestStatus @default(PENDING)
  approvedBy          String?
  approvedAt          DateTime?
  rejectedBy          String?
  rejectedAt          DateTime?
  rejectionReason     String?
  organizationId      Int?
  createdAt           DateTime                @default(now())
  createdBy           String                  @default("system@baro.local")
  createdByEmployeeId Int?
  updatedByEmployeeId Int?
  updatedAt           DateTime                @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id])

  createdByEmployee Employee? @relation("OnboardingRequestCreatedByEmployee", fields: [createdByEmployeeId], references: [id], onDelete: SetNull)
  updatedByEmployee Employee? @relation("OnboardingRequestUpdatedByEmployee", fields: [updatedByEmployeeId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([requesterEmail])
  @@index([requesterEmail, status])
}

model OrganizationSubscription {
  id                  Int                            @id @default(autoincrement())
  orgId               Int                            @unique
  status              OrganizationSubscriptionStatus @default(NOT_SUBSCRIBED)
  membershipEmail     String?
  billingEmail        String?
  trialStartedAt      DateTime?
  trialEndsAt         DateTime?
  activatedAt         DateTime?
  activeEndsAt        DateTime?
  suspendedAt         DateTime?
  createdAt           DateTime                       @default(now())
  createdBy           String                         @default("system@baro.local")
  createdByEmployeeId Int?
  updatedByEmployeeId Int?
  updatedAt           DateTime                       @updatedAt

  organization Organization @relation(fields: [orgId], references: [id])

  createdByEmployee Employee? @relation("OrganizationSubscriptionCreatedByEmployee", fields: [createdByEmployeeId], references: [id], onDelete: SetNull)
  updatedByEmployee Employee? @relation("OrganizationSubscriptionUpdatedByEmployee", fields: [updatedByEmployeeId], references: [id], onDelete: SetNull)

  @@index([status])
}

model Factory {
  id                           Int       @id @default(autoincrement())
  orgId                        Int
  name                         String
  nameKo                       String?
  nameVi                       String?
  factoryCode                  String?
  managementStartDate          String?
  address                      String?
  country                      String?
  countryCode                  String?
  phoneNumber                  String?
  manager                      String?
  managerEmployeeId            Int?
  targetMonthlyWage            Float?
  wagePerSecond                Float?
  productionAllowanceUpdatedAt DateTime?
  salaryCurrencyId             Int?
  createdAt                    DateTime  @default(now())
  createdBy                    String    @default("system@baro.local")
  createdByEmployeeId          Int?
  updatedByEmployeeId          Int?
  updatedAt                    DateTime  @updatedAt

  organization             Organization                     @relation(fields: [orgId], references: [id])
  managerEmployee          Employee?                        @relation("FactoryManager", fields: [managerEmployeeId], references: [id], onDelete: SetNull)
  employees                Employee[]                       @relation("FactoryEmployees")
  lines                    Line[]
  attendanceEntries        AttendanceEntry[]
  workLogs                 WorkLog[]
  atTrainingBuckets        AtTrainingBucket[]
  warehouses               Warehouse[]
  productionAllowanceRates FactoryProductionAllowanceRate[]
  salaryItems              SalaryItem[]
  salaryItemRates          SalaryItemRate[]
  salarySystemVersions     SalarySystemVersion[]
  payrollSnapshots         PayrollSnapshot[]
  salaryCurrency           Currency?                         @relation("FactorySalaryCurrency", fields: [salaryCurrencyId], references: [id], onDelete: Restrict)

  createdByEmployee Employee? @relation("FactoryCreatedByEmployee", fields: [createdByEmployeeId], references: [id], onDelete: SetNull)
  updatedByEmployee Employee? @relation("FactoryUpdatedByEmployee", fields: [updatedByEmployeeId], references: [id], onDelete: SetNull)

  @@unique([orgId, factoryCode])
  @@unique([id, orgId], map: "Factory_id_org_key")
  @@index([orgId])
  @@index([managerEmployeeId])
  @@index([salaryCurrencyId])
}

model FactoryProductionAllowanceRate {
  id                Int      @id @default(autoincrement())
  orgId             Int
  factoryId         Int
  versionNumber     Int
  effectiveMonth    String?
  targetMonthlyWage Float?
  wagePerSecond     Float
  createdAt         DateTime @default(now())
  createdBy         String   @default("system@baro.local")
  updatedAt         DateTime @updatedAt
  confirmedAt       DateTime @default(now())

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  factory      Factory      @relation(fields: [factoryId, orgId], references: [id, orgId], onDelete: Cascade, map: "FactoryProductionAllowanceRate_factory_org_fkey")

  @@unique([factoryId, effectiveMonth])
  @@unique([factoryId, versionNumber])
  @@index([orgId, effectiveMonth])
  @@index([factoryId, effectiveMonth])
}

model Warehouse {
  id                  Int      @id @default(autoincrement())
  orgId               Int
  factoryId           Int
  name                String
  nameKo              String?
  nameVi              String?
  isDefault           Boolean  @default(false)
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  createdBy           String   @default("system@baro.local")
  createdByEmployeeId Int?
  updatedByEmployeeId Int?
  updatedAt           DateTime @updatedAt

  organization      Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  factory           Factory      @relation(fields: [factoryId, orgId], references: [id, orgId], onDelete: Cascade, map: "Warehouse_factory_org_fkey")
  createdByEmployee Employee?    @relation("WarehouseCreatedByEmployee", fields: [createdByEmployeeId], references: [id], onDelete: SetNull)
  updatedByEmployee Employee?    @relation("WarehouseUpdatedByEmployee", fields: [updatedByEmployeeId], references: [id], onDelete: SetNull)

  @@unique([factoryId, name])
  @@index([orgId])
  @@index([factoryId, isActive])
}

model Line {
  id                  Int      @id @default(autoincrement())
  orgId               Int
  factoryId           Int
  name                String
  managerEmployeeId   Int?
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  createdBy           String   @default("system@baro.local")
  createdByEmployeeId Int?
  updatedByEmployeeId Int?
  updatedAt           DateTime @updatedAt

  organization    Organization     @relation(fields: [orgId], references: [id])
  factory         Factory          @relation(fields: [factoryId], references: [id])
  manager         Employee?        @relation("LineManager", fields: [managerEmployeeId], references: [id], onDelete: SetNull)
  assignments     LineAssignment[]
  assignmentPlans AssignmentPlan[]
  employees             Employee[]             @relation("EmployeeCurrentLine")
  workRecords           WorkRecord[]           @relation("WorkRecordLine")
  outsourcedWorkRecords OutsourcedWorkRecord[]  @relation("OutsourcedWorkRecordLine")

  createdByEmployee Employee? @relation("LineCreatedByEmployee", fields: [createdByEmployeeId], references: [id], onDelete: SetNull)
  updatedByEmployee Employee? @relation("LineUpdatedByEmployee", fields: [updatedByEmployeeId], references: [id], onDelete: SetNull)

  @@unique([factoryId, name])
  @@index([orgId])
  @@index([factoryId])
}

model Employee {
  id                  Int            @id @default(autoincrement())
  orgId               Int
  email               String?
  orgRole             OrgUserRole    @default(WORKER)
  status              EmployeeStatus @default(ACTIVE)
  requestedAt         DateTime?
  requestedName       String?
  approvedAt          DateTime?
  approvedBy          String?
  factoryId           Int?
  lineId              Int?
  roleId              Int?
  gradeId             Int            @default(dbgenerated())
  employeeNo          String?
  payType             String?
  name                String?
  phone               String?
  bankName            String?
  bankAccountNumber   String?
  position            String?
  joinedAt            DateTime?
  leftAt              DateTime?
  leaveStartAt        DateTime?
  leaveEndAt          DateTime?
  alwaysFullAttendance Boolean       @default(false)
  payrollExcluded      Boolean       @default(false)
  createdAt           DateTime       @default(now())
  createdBy           String         @default("system@baro.local")
  createdByEmployeeId Int?
  updatedByEmployeeId Int?
  updatedAt           DateTime       @updatedAt

  organization             Organization       @relation(fields: [orgId], references: [id])
  factory                  Factory?           @relation("FactoryEmployees", fields: [factoryId], references: [id])
  line                     Line?              @relation("EmployeeCurrentLine", fields: [lineId], references: [id], onDelete: SetNull)
  role                     AttrRole?          @relation(fields: [orgId, roleId], references: [orgId, id], onDelete: Restrict)
  grade                    EmployeeGrade      @relation(fields: [orgId, gradeId], references: [orgId, id])
  lineAssignments          LineAssignment[]
  representedOrganizations Organization[]     @relation("OrganizationRepresentative")
  managedFactories         Factory[]          @relation("FactoryManager")
  managedLines             Line[]             @relation("LineManager")
  attendanceEntries        AttendanceEntry[]
  workRecords              WorkRecord[]
  atTrainingBuckets        AtTrainingBucket[]

  createdByEmployee                  Employee?                         @relation("EmployeeCreatedByEmployee", fields: [createdByEmployeeId], references: [id], onDelete: SetNull)
  updatedByEmployee                  Employee?                         @relation("EmployeeUpdatedByEmployee", fields: [updatedByEmployeeId], references: [id], onDelete: SetNull)
  createdSystemUsers                 SystemUser[]                      @relation("SystemUserCreatedByEmployee")
  updatedSystemUsers                 SystemUser[]                      @relation("SystemUserUpdatedByEmployee")
  createdProcessMasterOptions        ProcessMasterOption[]             @relation("ProcessMasterOptionCreatedByEmployee")
  updatedProcessMasterOptions        ProcessMasterOption[]             @relation("ProcessMasterOptionUpdatedByEmployee")
  createdOrganizations               Organization[]                    @relation("OrganizationCreatedByEmployee")
  updatedOrganizations               Organization[]                    @relation("OrganizationUpdatedByEmployee")
  createdOnboardingRequests          OnboardingRequest[]               @relation("OnboardingRequestCreatedByEmployee")
  updatedOnboardingRequests          OnboardingRequest[]               @relation("OnboardingRequestUpdatedByEmployee")
  createdOrganizationSubscriptions   OrganizationSubscription[]        @relation("OrganizationSubscriptionCreatedByEmployee")
  updatedOrganizationSubscriptions   OrganizationSubscription[]        @relation("OrganizationSubscriptionUpdatedByEmployee")
  createdFactories                   Factory[]                         @relation("FactoryCreatedByEmployee")
  updatedFactories                   Factory[]                         @relation("FactoryUpdatedByEmployee")
  createdWarehouses                  Warehouse[]                       @relation("WarehouseCreatedByEmployee")
  updatedWarehouses                  Warehouse[]                       @relation("WarehouseUpdatedByEmployee")
  createdLines                       Line[]                            @relation("LineCreatedByEmployee")
  updatedLines                       Line[]                            @relation("LineUpdatedByEmployee")
  createdAttendanceEntries           AttendanceEntry[]                 @relation("AttendanceEntryCreatedByEmployee")
  updatedAttendanceEntries           AttendanceEntry[]                 @relation("AttendanceEntryUpdatedByEmployee")
  createdOrganizationHolidays        OrganizationHoliday[]             @relation("OrganizationHolidayCreatedByEmployee")
  updatedOrganizationHolidays        OrganizationHoliday[]             @relation("OrganizationHolidayUpdatedByEmployee")
  createdOrgRelationships            OrgRelationship[]                 @relation("OrgRelationshipCreatedByEmployee")
  updatedOrgRelationships            OrgRelationship[]                 @relation("OrgRelationshipUpdatedByEmployee")
  createdStyles                      Style[]                           @relation("StyleCreatedByEmployee")
  updatedStyles                      Style[]                           @relation("StyleUpdatedByEmployee")
  createdStyleProcesses              StyleProcess[]                    @relation("StyleProcessCreatedByEmployee")
  updatedStyleProcesses              StyleProcess[]                    @relation("StyleProcessUpdatedByEmployee")
  createdAtTrainingBuckets           AtTrainingBucket[]                @relation("AtTrainingBucketCreatedByEmployee")
  updatedAtTrainingBuckets           AtTrainingBucket[]                @relation("AtTrainingBucketUpdatedByEmployee")
  createdAtTrainingBucketProcesses   AtTrainingBucketProcess[]         @relation("AtTrainingBucketProcessCreatedByEmployee")
  updatedAtTrainingBucketProcesses   AtTrainingBucketProcess[]         @relation("AtTrainingBucketProcessUpdatedByEmployee")
  createdWorkOrders                  WorkOrder[]                       @relation("WorkOrderCreatedByEmployee")
  updatedWorkOrders                  WorkOrder[]                       @relation("WorkOrderUpdatedByEmployee")
  createdWorkOrderItems              WorkOrderItem[]                   @relation("WorkOrderItemCreatedByEmployee")
  updatedWorkOrderItems              WorkOrderItem[]                   @relation("WorkOrderItemUpdatedByEmployee")
  createdAssignmentPlans             AssignmentPlan[]                  @relation("AssignmentPlanCreatedByEmployee")
  updatedAssignmentPlans             AssignmentPlan[]                  @relation("AssignmentPlanUpdatedByEmployee")
  reviewedAssignmentPlanCts          AssignmentPlan[]                  @relation("AssignmentPlanCtReviewedByEmployee")
  createdQcPassEvents                QcPassEvent[]                     @relation("QcPassEventCreatedByEmployee")
  updatedQcPassEvents                QcPassEvent[]                     @relation("QcPassEventUpdatedByEmployee")
  createdWorkLogs                    WorkLog[]                         @relation("WorkLogCreatedByEmployee")
  updatedWorkLogs                    WorkLog[]                         @relation("WorkLogUpdatedByEmployee")
  createdWorkRecords                 WorkRecord[]                      @relation("WorkRecordCreatedByEmployee")
  updatedWorkRecords                 WorkRecord[]                      @relation("WorkRecordUpdatedByEmployee")
  createdOutsourcedWorkRecords       OutsourcedWorkRecord[]            @relation("OutsourcedWorkRecordCreatedByEmployee")
  updatedOutsourcedWorkRecords       OutsourcedWorkRecord[]            @relation("OutsourcedWorkRecordUpdatedByEmployee")
  createdPayrollSnapshots            PayrollSnapshot[]                 @relation("PayrollSnapshotCreatedByEmployee")
  updatedPayrollSnapshots            PayrollSnapshot[]                 @relation("PayrollSnapshotUpdatedByEmployee")
  createdQuantitySettlementSnapshots QuantitySettlementSnapshot[]      @relation("QuantitySettlementSnapshotCreatedByEmployee")
  updatedQuantitySettlementSnapshots QuantitySettlementSnapshot[]      @relation("QuantitySettlementSnapshotUpdatedByEmployee")
  createdAssignmentBoardStates       AssignmentBoardState[]            @relation("AssignmentBoardStateCreatedByEmployee")
  updatedAssignmentBoardStates       AssignmentBoardState[]            @relation("AssignmentBoardStateUpdatedByEmployee")
  createdAssignmentCards             AssignmentCard[]                  @relation("AssignmentCardCreatedByEmployee")
  updatedAssignmentCards             AssignmentCard[]                  @relation("AssignmentCardUpdatedByEmployee")
  createdSalesBucketOverrides        OrgRelationshipStyleSalesBucket[] @relation("SalesBucketOverrideCreatedByEmployee")
  updatedSalesBucketOverrides        OrgRelationshipStyleSalesBucket[] @relation("SalesBucketOverrideUpdatedByEmployee")
  createdTimeBucketOverrides         OrgRelationshipStyleTimeBucket[]  @relation("TimeBucketOverrideCreatedByEmployee")
  updatedTimeBucketOverrides         OrgRelationshipStyleTimeBucket[]  @relation("TimeBucketOverrideUpdatedByEmployee")
  createdSalesPriceLists             CustomerSalesPriceList[]          @relation("SalesPriceListCreatedByEmployee")
  updatedSalesPriceLists             CustomerSalesPriceList[]          @relation("SalesPriceListUpdatedByEmployee")
  createdSalesPrices                 CustomerSalesPrice[]              @relation("SalesPriceCreatedByEmployee")
  updatedSalesPrices                 CustomerSalesPrice[]              @relation("SalesPriceUpdatedByEmployee")
  updatedSystemSettings              SystemSetting[]                   @relation("SystemSettingUpdatedByEmployee")
  createdEmployees                   Employee[]                        @relation("EmployeeCreatedByEmployee")
  updatedEmployees                   Employee[]                        @relation("EmployeeUpdatedByEmployee")

  @@unique([orgId, email])
  @@unique([orgId, employeeNo])
  @@index([orgId])
  @@index([factoryId])
  @@index([lineId])
  @@index([roleId])
  @@index([gradeId])
  @@index([email])
  @@index([status])
  @@index([orgId, status])
}

model EmployeeGradeSet {
  id        Int      @id @default(autoincrement())
  orgId     Int
  code      String
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  grades       EmployeeGrade[]

  @@unique([orgId, code])
  @@index([orgId, isActive])
}

model EmployeeGrade {
  id        Int      @id @default(autoincrement())
  orgId     Int
  setId     Int
  code      String
  name      String
  nameKo    String
  nameEn    String
  nameVi    String
  sortOrder Int
  isDefault Boolean  @default(false)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization         Organization                 @relation(fields: [orgId], references: [id], onDelete: Cascade)
  set                  EmployeeGradeSet             @relation(fields: [setId], references: [id], onDelete: Cascade)
  employees            Employee[]
  compensationPolicies EmployeeCompensationPolicy[]
  salaryItemRates       SalaryItemRate[]

  @@unique([orgId, code])
  @@unique([orgId, id])
  @@unique([setId, sortOrder])
  @@index([orgId, isActive, sortOrder])
}

model EmployeeCompensationPolicy {
  id                Int         @id @default(autoincrement())
  orgId             Int
  payType           String
  gradeId           Int
  baseSalary        Int         @default(0)
  allowance         Int         @default(0)
  incentive         Int         @default(0)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  organization Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  grade        EmployeeGrade @relation(fields: [orgId, gradeId], references: [orgId, id], onDelete: Cascade)

  @@unique([orgId, payType, gradeId])
  @@index([orgId, gradeId])
}

model EmployeePayTypePolicy {
  id                    Int      @id @default(autoincrement())
  orgId                 Int
  payType               String
  workWeekdays          Json
  standardClockIn       String   @default("08:00")
  standardClockOut      String   @default("17:00")
  breakMinutes          Int      @default(60)
  workdayMinimumMinutes Int      @default(240)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, payType])
  @@index([orgId])
}

model SalaryItem {
  id        Int      @id @default(autoincrement())
  orgId     Int
  factoryId Int
  code      String
  name      String
  nameKo    String
  nameEn    String
  nameVi    String
  category  String
