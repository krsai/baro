  updatedByEmployee Employee? @relation("PayrollSnapshotUpdatedByEmployee", fields: [updatedByEmployeeId], references: [id], onDelete: SetNull)

  @@unique([orgId, month, factoryId])
  @@index([orgId])
  @@index([factoryId])
}

