  updatedByEmployee    Employee? @relation("AssignmentPlanUpdatedByEmployee", fields: [updatedByEmployeeId], references: [id], onDelete: SetNull)
  ctReviewedByEmployee Employee? @relation("AssignmentPlanCtReviewedByEmployee", fields: [ctReviewedByEmployeeId], references: [id], onDelete: SetNull)

  @@unique([orgId, externalId])
  @@unique([id, orgId], map: "AssignmentPlan_id_org_key")
  @@index([orgId, lineId])
  @@index([workOrderId])
  @@index([styleId])
  @@index([assignmentCardId])
  @@index([buyerOrgId])
  @@index([orgRelationshipId])
  @@index([ctReviewedByEmployeeId])
