// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DIRECT_URL")
  directUrl = env("DIRECT_URL")
}

enum OrganizationType {
  MANUFACTURER
  BRAND
}

enum OrgUserRole {
  ADMIN
  OPERATOR
  ACCOUNTANT
  WORKER
}

enum OrgMembershipStatus {
  PENDING
  ACTIVE
  REJECTED
  SUSPENDED
  TERMINATED
}

enum OrganizationSubscriptionStatus {
  NOT_SUBSCRIBED
  TRIAL
  ACTIVE
  GRACE
  SUSPENDED
}

enum OnboardingRequestType {
  REGISTER_ORG
}

enum OnboardingRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum WorkOrderStatus {
  EDITING
  ORDER_RECEIVED
  IN_PROGRESS
  PRODUCTION_DONE
  SHIPPED
  SETTLED
}

enum WorkOrderConfirmationStatus {
  PLANNED
  CONFIRMED
}

enum WorkOrderItemGender {
  M
  W
  U
}

enum SystemRole {
  SYSTEM_ADMIN
  USER
}

enum ProcessMasterOptionType {
  LOCATION
  PART
  TARGET
  TARGET_SPEC
  ACTION
  ACTION_SPEC
  SPEC
}

enum AssignmentCloseMode {
  FULL
  SHORT
  OVER
}

enum AssignmentCloseBasis {
  QC_BASED
  MANUAL
}

enum QcPassEventSourceType {
  MANUAL
  MIGRATED_LEGACY
}

model SystemUser {
  id         Int        @id @default(autoincrement())
  email      String     @unique
  systemRole SystemRole @default(USER)
  createdAt  DateTime   @default(now())
  createdBy String   @default("system@baro.local")
  updatedAt  DateTime   @updatedAt
}

model ProcessMasterOption {
  id        Int                     @id @default(autoincrement())
  type      ProcessMasterOptionType
  code      String
  label     String
  nameKo    String?
  nameEn    String?
  nameVi    String?
  sortOrder Int                     @default(0)
  createdAt DateTime                @default(now())
  createdBy String   @default("system@baro.local")
  updatedAt DateTime                @updatedAt
  parentRelations ProcessMasterOptionRelation[] @relation("ProcessMasterOptionRelationParent")
  childRelations  ProcessMasterOptionRelation[] @relation("ProcessMasterOptionRelationChild")

  @@unique([type, code])
  @@index([type, sortOrder, id])
}

model ProcessMasterOptionRelation {
  id             Int                 @id @default(autoincrement())
  type           String
  parentOptionId Int
  childOptionId  Int
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  parentOption   ProcessMasterOption @relation("ProcessMasterOptionRelationParent", fields: [parentOptionId], references: [id], onDelete: Cascade)
  childOption    ProcessMasterOption @relation("ProcessMasterOptionRelationChild", fields: [childOptionId], references: [id], onDelete: Cascade)

  @@unique([type, parentOptionId, childOptionId])
  @@index([parentOptionId])
  @@index([childOptionId])
}

model Organization {
  id             Int              @id @default(autoincrement())
  name           String
  nameKo         String?
  nameVi         String?
  code           String?          @unique
  businessNumber String?
  representative String?
  representativeEmployeeId Int?
  industry       String?
  address        String?
  country        String?
  countryCode    String?
  phone          String?
  email          String?
  targetMonthlyWage Float?
  wagePerSecond     Float?
  type           OrganizationType @default(MANUFACTURER)
  createdAt      DateTime         @default(now())
  createdBy String   @default("system@baro.local")
  updatedAt      DateTime         @updatedAt

  categories                AttrCategory[]
  roles                     AttrRole[]
  processes                 AttrProcess[]
  subscription              OrganizationSubscription?
  memberships               OrgMembership[]
  factories                 Factory[]
  employees                 Employee[]
  lines                     Line[]
  styles                    Style[]
  styleProcesses            StyleProcess[]
  styleProcessStandards     StyleProcessStandard[]
  orders                    WorkOrder[]
  workLogs                  WorkLog[]
  workRecords               WorkRecord[]
  assignmentBoardState      AssignmentBoardState?
  assignmentCards           AssignmentCard[]
  assignmentPlans           AssignmentPlan[]
  buyerAssignmentCards      AssignmentCard[]           @relation("AssignmentCardBuyerOrg")
  buyerAssignmentPlans      AssignmentPlan[]           @relation("AssignmentPlanBuyerOrg")
  qcPassEvents             QcPassEvent[]
  payrollSnapshots          PayrollSnapshot[]
  quantitySettlementSnapshots QuantitySettlementSnapshot[]
  attendanceEntries         AttendanceEntry[]
  holidays                  OrganizationHoliday[]
  atTrainingBuckets         AtTrainingBucket[]
  atTrainingBucketProcesses AtTrainingBucketProcess[]
  representativeEmployee    Employee?                  @relation("OrganizationRepresentative", fields: [representativeEmployeeId], references: [id], onDelete: SetNull)
  manufacturerRelationships OrgRelationship[]         @relation("ManufacturerOrgRelationships")
  brandRelationships        OrgRelationship[]         @relation("BrandOrgRelationships")
  onboardingRequests        OnboardingRequest[]
  buyerWorkOrders           WorkOrder[]              @relation("WorkOrderBuyerOrg")
  sellerWorkOrders          WorkOrder[]              @relation("WorkOrderSellerOrg")
  customerWorkOrders        WorkOrder[]              @relation("WorkOrderCustomerOrg")

  @@index([representativeEmployeeId])
}

model SystemSetting {
  key       String   @id
  value     Json
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OnboardingRequest {
  id                 Int                     @id @default(autoincrement())
  requesterEmail     String
  requestType        OnboardingRequestType   @default(REGISTER_ORG)
  organizationNameEn String
  organizationType   OrganizationType        @default(MANUFACTURER)
  country            String                  @default("KR")
  companyAddress     String                  @default("")
  businessNumber     String
  contactName        String                  @default("")
  contactEmail       String
  contactPhone       String
  status             OnboardingRequestStatus @default(PENDING)
  approvedBy         String?
  approvedAt         DateTime?
  rejectedBy         String?
  rejectedAt         DateTime?
  rejectionReason    String?
  organizationId     Int?
  createdAt          DateTime                @default(now())
  createdBy String   @default("system@baro.local")
  updatedAt          DateTime                @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id])

  @@index([status])
  @@index([requesterEmail])
  @@index([requesterEmail, status])
}

model OrganizationSubscription {
  id              Int                            @id @default(autoincrement())
  orgId           Int                            @unique
  status          OrganizationSubscriptionStatus @default(NOT_SUBSCRIBED)
  membershipEmail String?
  billingEmail    String?
  trialStartedAt  DateTime?
  trialEndsAt     DateTime?
  activatedAt     DateTime?
  activeEndsAt    DateTime?
  suspendedAt     DateTime?
  createdAt       DateTime                       @default(now())
  createdBy String   @default("system@baro.local")
  updatedAt       DateTime                       @updatedAt

  organization Organization @relation(fields: [orgId], references: [id])

  @@index([status])
}

model OrgMembership {
  id          Int                 @id @default(autoincrement())
  orgId       Int
  email       String?
  role        OrgUserRole         @default(OPERATOR)
  status      OrgMembershipStatus @default(ACTIVE)
  requestedAt DateTime?
  requestedName String?
  approvedAt  DateTime?
  approvedBy  String?
  createdAt   DateTime            @default(now())
  createdBy String   @default("system@baro.local")
  updatedAt   DateTime            @updatedAt

  organization Organization @relation(fields: [orgId], references: [id])
  employee     Employee?

  @@unique([orgId, email])
  @@index([orgId])
  @@index([email])
  @@index([status])
  @@index([orgId, status])
}

model Factory {
  id                Int      @id @default(autoincrement())
  orgId             Int
  name              String
  nameKo            String?
  nameVi            String?
  factoryCode       String?
  managementStartDate String?
  address           String?
  country           String?
  countryCode       String?
  phoneNumber       String?
  manager           String?
  managerEmployeeId Int?
  targetMonthlyWage Float?
  wagePerSecond     Float?
  createdAt         DateTime @default(now())
  createdBy String   @default("system@baro.local")
  updatedAt         DateTime @updatedAt

  organization      Organization      @relation(fields: [orgId], references: [id])
  managerEmployee   Employee?         @relation("FactoryManager", fields: [managerEmployeeId], references: [id], onDelete: SetNull)
  employees         Employee[]        @relation("FactoryEmployees")
  lines             Line[]
  attendanceEntries AttendanceEntry[]
  workLogs          WorkLog[]
  atTrainingBuckets AtTrainingBucket[]

  @@unique([orgId, factoryCode])
  @@index([orgId])
  @@index([managerEmployeeId])
}

model Line {
  id                Int      @id @default(autoincrement())
  orgId             Int
  factoryId         Int
  name              String
  managerEmployeeId Int?
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  createdBy String   @default("system@baro.local")
  updatedAt         DateTime @updatedAt

  organization    Organization     @relation(fields: [orgId], references: [id])
  factory         Factory          @relation(fields: [factoryId], references: [id])
  manager         Employee?        @relation("LineManager", fields: [managerEmployeeId], references: [id], onDelete: SetNull)
  assignments     LineAssignment[]
  assignmentPlans AssignmentPlan[]
  employees       Employee[]        @relation("EmployeeCurrentLine")
  workRecords     WorkRecord[]      @relation("WorkRecordLine")

  @@unique([factoryId, name])
  @@index([orgId])
  @@index([factoryId])
}

model Employee {
  id                Int       @id @default(autoincrement())
  orgId             Int
  orgMembershipId   Int       @unique
  factoryId         Int?
  lineId            Int?
  roleId            Int?
  employeeNo        String?
  payType           String?
  fixedSalary       Int?
  name              String?
  phone             String?
  bankName          String?
  bankAccountNumber String?
  position          String?
  joinedAt          DateTime?
  leftAt            DateTime?
  leaveStartAt      DateTime?
  leaveEndAt        DateTime?
  createdAt         DateTime  @default(now())
  createdBy String   @default("system@baro.local")
  updatedAt         DateTime  @updatedAt

  organization      Organization      @relation(fields: [orgId], references: [id])
  membership        OrgMembership     @relation(fields: [orgMembershipId], references: [id])
  factory           Factory?          @relation("FactoryEmployees", fields: [factoryId], references: [id])
  line              Line?             @relation("EmployeeCurrentLine", fields: [lineId], references: [id], onDelete: SetNull)
  role              AttrRole?         @relation(fields: [roleId], references: [id])
  lineAssignments   LineAssignment[]
  representedOrganizations Organization[]     @relation("OrganizationRepresentative")
  managedFactories  Factory[]         @relation("FactoryManager")
  managedLines      Line[]            @relation("LineManager")
  attendanceEntries AttendanceEntry[]
  workRecords       WorkRecord[]

  @@index([orgId])
  @@index([factoryId])
  @@index([lineId])
  @@index([roleId])
  @@unique([orgId, employeeNo])
}

model AttendanceEntry {
  id            Int      @id @default(autoincrement())
  orgId         Int
  factoryId     Int
  workerId      Int
  workDate      String
  clockIn       String?
  clockOut      String?
  workedSeconds Int?
  note          String?
  createdAt     DateTime @default(now())
  createdBy String   @default("system@baro.local")
  updatedAt     DateTime @updatedAt

  organization Organization @relation(fields: [orgId], references: [id])
  factory      Factory      @relation(fields: [factoryId], references: [id])
  worker       Employee     @relation(fields: [workerId], references: [id])

  @@unique([orgId, factoryId, workerId, workDate])
  @@index([orgId, workDate])
  @@index([orgId, factoryId, workDate])
  @@index([orgId, workerId, workDate])
}

model OrganizationHoliday {
  id          Int      @id @default(autoincrement())
  orgId       Int
  holidayDate String
  createdAt   DateTime @default(now())
  createdBy   String   @default("system@baro.local")
  updatedAt   DateTime @updatedAt

  organization Organization @relation(fields: [orgId], references: [id])

  @@unique([orgId, holidayDate])
  @@index([orgId, holidayDate])
}

model LineAssignment {
  id         Int       @id @default(autoincrement())
  lineId     Int
  employeeId Int
  startAt    DateTime  @default(now())
  endAt      DateTime?

  line     Line     @relation(fields: [lineId], references: [id])
  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([lineId])
  @@index([employeeId])
  @@index([endAt])
}

model OrgRelationship {
  id                Int      @id @default(autoincrement())
  manufacturerOrgId Int
  brandOrgId        Int
  customerCode      String?
  managerName       String?
  managerPhone      String?
  managerEmail      String?
  memo              String?
  pricingDefaultTradeType String?
  pricingMatrix     Json?
  createdAt         DateTime @default(now())
  createdBy String   @default("system@baro.local")
  updatedAt         DateTime @updatedAt

  manufacturer Organization @relation("ManufacturerOrgRelationships", fields: [manufacturerOrgId], references: [id])
  brand        Organization @relation("BrandOrgRelationships", fields: [brandOrgId], references: [id])

  @@unique([manufacturerOrgId, brandOrgId])
  @@index([manufacturerOrgId])
  @@index([brandOrgId])
}

model AttrColor {
  id     Int     @id @default(autoincrement())
  code   String  @unique
  name   String
  nameKo String?
  nameEn String?
  nameVi String?

  workOrderItems  WorkOrderItem[]
  qcPassEvents   QcPassEvent[]
}

model AttrCategory {
  id     Int     @id @default(autoincrement())
  orgId  Int
  code   String
  name   String
  nameKo String?
  nameEn String?
  nameVi String?

  organization Organization @relation(fields: [orgId], references: [id])

  @@unique([orgId, code])
  @@index([orgId])
}

model AttrRole {
  id             Int    @id @default(autoincrement())
  orgId          Int
  code           String
  name           String
  defaultPayType String @default("FIXED")
  sortOrder      Int    @default(0)

  organization Organization @relation(fields: [orgId], references: [id])
  employees    Employee[]

  @@unique([orgId, code])
  @@index([orgId])
  @@index([orgId, sortOrder])
}

model AttrProcess {
  id     Int     @id @default(autoincrement())
  orgId  Int
  code   String
  name   String
  nameKo String?
  nameEn String?
  nameVi String?

  organization Organization @relation(fields: [orgId], references: [id])

  @@unique([orgId, code])
  @@index([orgId])
}

model Style {
  id               Int      @id @default(autoincrement())
  orgId            Int
  code             String
  name             String
  registrationDate String?
  designer         String?
  collection       String?
  season           String?
  imageUrls        Json?
  /// Deprecated 2026-07-02. No longer written by new/updated code paths —
  /// StyleProcess/StyleProcessStandard (FK styleId) are the source of truth. Kept only
  /// as a one-time seed for `ensureStyleProcessStorageForStyles`' self-healing backfill
  /// of legacy styles; every response/calculation path reads the relational mirror, not
  /// this column. Run `npm run verify:style-process-backfill` (0 results) before dropping.
  processes        Json?
  bom              Json?
  bomNotes         String?
  revenueMemo      String?
  createdAt        DateTime @default(now())
  createdBy String   @default("system@baro.local")
  updatedAt        DateTime @updatedAt

  organization   Organization    @relation(fields: [orgId], references: [id])
  styleProcesses StyleProcess[]
  workOrderItems WorkOrderItem[]
  trainingBuckets AtTrainingBucketProcess[]
  assignmentPlans AssignmentPlan[]
  assignmentCards AssignmentCard[]
  workRecords    WorkRecord[]

  @@unique([orgId, code])
  @@unique([orgId, name])
  @@index([orgId])
}

model StyleProcess {
  id                 Int      @id @default(autoincrement())
  orgId              Int
  styleId            Int
  processCode        String
  processName        String
  processComposition Json?
  processDescription String?
  timesPerPiece      Int      @default(1)
  sortOrder          Int      @default(0)
  ptSeconds          Float?
  atParams           Json?
  createdAt          DateTime @default(now())
  createdBy String   @default("system@baro.local")
  updatedAt          DateTime @updatedAt

  organization Organization          @relation(fields: [orgId], references: [id])
  style        Style                 @relation(fields: [styleId], references: [id], onDelete: Cascade)
  standards    StyleProcessStandard[]
  trainingBuckets AtTrainingBucketProcess[]
  workRecords  WorkRecord[]

  @@unique([styleId, orgId, processCode])
  @@index([orgId])
  @@index([styleId])
}

model StyleProcessStandard {
  id             Int      @id @default(autoincrement())
  orgId          Int
  styleProcessId Int
  bucketQuantity Int
  bucketStSeconds Float
  setBy          String?
  setAt          DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [orgId], references: [id])
  styleProcess StyleProcess @relation(fields: [styleProcessId], references: [id], onDelete: Cascade)

  @@unique([styleProcessId, bucketQuantity])
  @@index([orgId])
  @@index([styleProcessId])
}

model AtTrainingBucket {
  id                 Int      @id @default(autoincrement())
  orgId              Int
  monthKey           String
  sourceWorkLogId    Int
  workDate           String
  factoryId          Int?
  laborInputSeconds  Float
  attendanceCoverage Float?
  createdAt          DateTime @default(now())
  createdBy String   @default("system@baro.local")
  updatedAt          DateTime @updatedAt

  organization Organization             @relation(fields: [orgId], references: [id])
  sourceWorkLog WorkLog                  @relation(fields: [sourceWorkLogId], references: [id], onDelete: Cascade)
  factory       Factory?                 @relation(fields: [factoryId], references: [id], onDelete: SetNull)
  processRows   AtTrainingBucketProcess[]

  @@unique([orgId, sourceWorkLogId])
  @@index([orgId, monthKey, workDate])
  @@index([orgId, workDate])
  @@index([factoryId])
}

model AtTrainingBucketProcess {
  id             Int      @id @default(autoincrement())
  orgId          Int
  bucketId       Int
  styleId        Int
  styleProcessId Int
  quantity       Int
  createdAt      DateTime @default(now())
  createdBy String   @default("system@baro.local")
  updatedAt      DateTime @updatedAt

  organization Organization     @relation(fields: [orgId], references: [id])
  bucket       AtTrainingBucket  @relation(fields: [bucketId], references: [id], onDelete: Cascade)
  style        Style             @relation(fields: [styleId], references: [id], onDelete: Cascade)
  styleProcess StyleProcess      @relation(fields: [styleProcessId], references: [id], onDelete: Cascade)

  @@unique([bucketId, styleProcessId])
  @@index([orgId, styleProcessId])
  @@index([orgId, styleId])
}

model WorkOrder {
  id            Int             @id @default(autoincrement())
  orgId         Int
  orderId       String
  orderNumber   String
  buyerOrgId      Int?
  sellerOrgId     Int?
  customerId    Int?
  dueDate       String?
  status        WorkOrderStatus @default(EDITING)
  confirmationStatus WorkOrderConfirmationStatus @default(PLANNED)
  modificationLockedAt DateTime?
  modificationLockedBy String?
  /// Deprecated 2026-07-02. No longer written by new/updated code paths — WorkOrderItem
  /// (FK workOrderId) is the source of truth. Read-dead except for legacy pre-relational
  /// rows; run `npm run verify:workorder-item-backfill` before dropping this column.
  items         Json?
  totalQuantity Int             @default(0)
  createdAt     DateTime        @default(now())
  createdBy String   @default("system@baro.local")
  updatedAt     DateTime        @updatedAt

  organization   Organization    @relation(fields: [orgId], references: [id])
  buyerOrg       Organization?   @relation("WorkOrderBuyerOrg", fields: [buyerOrgId], references: [id], onDelete: SetNull)
  sellerOrg      Organization?   @relation("WorkOrderSellerOrg", fields: [sellerOrgId], references: [id], onDelete: SetNull)
  customerOrg    Organization?   @relation("WorkOrderCustomerOrg", fields: [customerId], references: [id], onDelete: SetNull)
  workOrderItems WorkOrderItem[]
  assignmentPlans AssignmentPlan[]
  assignmentCards AssignmentCard[]

  @@unique([orgId, orderId])
  @@unique([orgId, customerId, orderNumber])
  @@unique([buyerOrgId, sellerOrgId, orderNumber])
  @@index([orgId])
  @@index([orgId, orderNumber])
}

model WorkOrderItem {
  id             Int                  @id @default(autoincrement())
  workOrderId    Int
  itemId         String               @default("")
  styleId        Int?
  colorId        Int?
  gender         WorkOrderItemGender?
  sizeQuantities Json?
  totalQuantity  Int                  @default(0)
  sortOrder      Int                  @default(0)
  createdAt      DateTime             @default(now())
  createdBy String   @default("system@baro.local")
  updatedAt      DateTime             @updatedAt

  workOrder WorkOrder  @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  style     Style?     @relation(fields: [styleId], references: [id], onDelete: SetNull)
  color     AttrColor? @relation(fields: [colorId], references: [id], onDelete: SetNull)

  @@index([workOrderId])
  @@index([styleId])
  @@index([colorId])
}

model AssignmentPlan {
  id                    Int       @id @default(autoincrement())
  orgId                 Int
  lineId                Int
  externalId            String
  cardId                String?
  assignmentCardId      Int?
  workOrderId           Int?
  styleId               Int?
  // Real FK replacing the "customer" string copy (AssignmentCard/AssignmentPlan
  // FK+join redesign, Phase A). Named buyerOrgId (not customerId) to match
  // WorkOrder's own naming - the ordering party (buyer org), same as
  // WorkOrder.buyerOrgId. Backfilled via assignmentCardId -> AssignmentCard.buyerOrgId.
  buyerOrgId            Int?
  // orderNo/customer/label/previewUrl were dropped in Phase E (AssignmentCard/
  // AssignmentPlan FK+join redesign) - all four are fully derivable through
  // workOrderId/styleId/buyerOrgId (workOrder.orderNumber, style.name,
  // buyerOrg.name, style.imageUrls[0]), so keeping them as separate text
  // columns was pure duplication once those FKs existed. See toAssignmentPlanResponse.
  assignmentQuantity       Int?
  originOrderId            String?
  basis                    String?
  assignmentCtTotalSeconds Int?
  assignmentCtSnapshot     Json?
  assignmentStTotalSeconds Int?
  startIndex               Int
  endIndex                 Int
  startDayOffsetPercent    Float?
  startDayPercent          Float?
  endDayPercent            Float?
  isCompleted           Boolean   @default(false)
  finalQuantity         Int?
  completedAt           DateTime?
  productionCompletedAt DateTime?
  actualProducedCompletedAt DateTime?
  candidateEndDate      DateTime?
  renderEndDate         DateTime?
  forecastCompletedAt   DateTime?
  forecastBasis         String?
  confidence            String?
  scheduleStatus        String?
  qcPassedTotal         Int       @default(0)
  latestQcDate          String?
  closedQty             Int?
  closedAt              DateTime?
  closedBy              String?
  closeMode             AssignmentCloseMode?
  closeBasis            AssignmentCloseBasis?
  createdAt             DateTime  @default(now())
  createdBy String   @default("system@baro.local")
  updatedAt             DateTime

  line           Line            @relation(fields: [lineId], references: [id], onDelete: Restrict)
  organization   Organization    @relation(fields: [orgId], references: [id])
  workOrder      WorkOrder?      @relation(fields: [workOrderId], references: [id], onDelete: SetNull)
  style          Style?          @relation(fields: [styleId], references: [id], onDelete: SetNull)
  buyerOrg       Organization?   @relation("AssignmentPlanBuyerOrg", fields: [buyerOrgId], references: [id], onDelete: SetNull)
  // Real FK replacing the old "cardId string happens to match" convention
  // (AGENTS.md structural-problems list). cardId itself is kept for now as
  // a read compatibility fallback during the migration - see AGENTS.md 43.
  assignmentCard AssignmentCard? @relation(fields: [assignmentCardId], references: [id], onDelete: SetNull)
  workRecords    WorkRecord[]
  qcPassEvents   QcPassEvent[]

  @@unique([orgId, externalId])
  @@index([orgId, lineId])
  @@index([workOrderId])
  @@index([styleId])
  @@index([assignmentCardId])
  @@index([buyerOrgId])
}

model QcPassEvent {
  id               Int                   @id @default(autoincrement())
  orgId            Int
  assignmentPlanId Int
  inspectedOn      String
  passedQuantity   Int                   @default(0)
  colorId          Int?
  sizeKey          String?
  note             String?
  sourceType       QcPassEventSourceType @default(MANUAL)
  cancelledAt      DateTime?
  cancelledBy      String?
  createdAt        DateTime              @default(now())
  createdBy        String                @default("system@baro.local")
  updatedAt        DateTime              @updatedAt

  organization   Organization   @relation(fields: [orgId], references: [id])
  assignmentPlan AssignmentPlan @relation(fields: [assignmentPlanId], references: [id], onDelete: Cascade)
  attrColor      AttrColor?     @relation(fields: [colorId], references: [id], onDelete: SetNull)

  @@index([orgId, assignmentPlanId, inspectedOn])
  @@index([orgId, inspectedOn])
  @@index([assignmentPlanId])
  @@index([colorId])
}

model WorkLog {
  id                     Int      @id @default(autoincrement())
  orgId                  Int
  displayDate            String   @map("workDate")
  coverageStartDate      String?
  coverageEndDate        String?
  entryMode              String?
  factoryId              Int?
  factoryWagePerSecond   Float?
  ctBasis                String   @default("CT")
  workerCount            Int      @default(0)
  itemCount              Int      @default(0)
  totalCtSeconds         Float    @default(0)
  note                   String?
  /// Header metadata only ({ lineId, lineName }) — never a copy of row data. WorkRecord
  /// (FK workLogId) is and has always been the sole source of truth for record rows;
  /// do not read this field as a records-list fallback.
  records                Json?
  updatedBy              String?
  createdAt              DateTime @default(now())
  createdBy String   @default("system@baro.local")
  updatedAt              DateTime @updatedAt

  organization     Organization             @relation(fields: [orgId], references: [id])
  factory          Factory?                 @relation(fields: [factoryId], references: [id], onDelete: SetNull)
  workRecords      WorkRecord[]
  atTrainingBuckets AtTrainingBucket[]

  @@index([orgId, displayDate])
  @@index([orgId, createdAt])
  @@index([factoryId])
}

model WorkRecord {
  id               Int      @id @default(autoincrement())
  orgId            Int
  workLogId        Int
  workerId         Int?
  lineId           Int?
  styleId          Int?
  styleProcessId   Int?
  assignmentPlanId Int?
  effectiveCoverageStartDate String?
  effectiveCoverageEndDate   String?
  ctSeconds        Int      @default(0)
  quantity         Int      @default(0)
  createdAt        DateTime @default(now())
  createdBy String   @default("system@baro.local")
  updatedAt        DateTime @updatedAt

  organization   Organization    @relation(fields: [orgId], references: [id])
  workLog        WorkLog         @relation(fields: [workLogId], references: [id], onDelete: Cascade)
  worker         Employee?       @relation(fields: [workerId], references: [id], onDelete: SetNull)
  assignmentPlan AssignmentPlan? @relation(fields: [assignmentPlanId], references: [id], onDelete: SetNull)
  style          Style?          @relation(fields: [styleId], references: [id], onDelete: SetNull)
  styleProcess   StyleProcess?   @relation(fields: [styleProcessId], references: [id], onDelete: SetNull)
  line           Line?           @relation("WorkRecordLine", fields: [lineId], references: [id], onDelete: SetNull)

  @@index([orgId, workLogId])
  @@index([orgId, workerId])
  @@index([orgId, styleId])
  @@index([orgId, lineId])
  @@index([styleProcessId])
  @@index([assignmentPlanId])
  @@index([workLogId])
}

model PayrollSnapshot {
  id        Int      @id @default(autoincrement())
  orgId     Int
  month     String
  data      Json
  lockedAt  DateTime
  lockedBy  String
  createdAt DateTime @default(now())
  createdBy String   @default("system@baro.local")

  organization Organization @relation(fields: [orgId], references: [id])

  @@unique([orgId, month])
  @@index([orgId])
}

model QuantitySettlementSnapshot {
  id        Int      @id @default(autoincrement())
  orgId     Int
  month     String
  data      Json
  createdAt DateTime @default(now())
  createdBy String   @default("system@baro.local")
  updatedAt DateTime @updatedAt
  updatedBy String   @default("system@baro.local")

  organization Organization @relation(fields: [orgId], references: [id])

  @@unique([orgId, month])
  @@index([orgId])
}

model AssignmentBoardState {
  id          Int      @id @default(autoincrement())
  orgId       Int      @unique
  /// Deprecated board payload mirror. AssignmentCard is the canonical card store.
  cards       Json?
  /// Deprecated board payload mirror. AssignmentPlan is the canonical assignment store.
  assignments Json?
  createdAt   DateTime @default(now())
  createdBy String   @default("system@baro.local")
  updatedAt   DateTime @updatedAt

  organization Organization @relation(fields: [orgId], references: [id])

  @@index([orgId])
}

model AssignmentCard {
  id        Int      @id @default(autoincrement())
  orgId     Int
  cardId    String
  sortOrder Int      @default(0)
  payload   Json
  createdAt DateTime @default(now())
  createdBy String   @default("system@baro.local")
  updatedAt DateTime @updatedAt

  // Real FK columns replacing the "payload JSON happens to carry these
  // ints/strings" convention (AGENTS.md AssignmentCard/AssignmentPlan
  // FK+join redesign, Phase A). payload keeps the same values for now as a
  // read-compatibility fallback during the migration - do not remove yet.
  styleId     Int?
  workOrderId Int?
  buyerOrgId  Int?

  organization    Organization     @relation(fields: [orgId], references: [id])
  style           Style?           @relation(fields: [styleId], references: [id], onDelete: SetNull)
  workOrder       WorkOrder?       @relation(fields: [workOrderId], references: [id], onDelete: SetNull)
  buyerOrg        Organization?    @relation("AssignmentCardBuyerOrg", fields: [buyerOrgId], references: [id], onDelete: SetNull)
  assignmentPlans AssignmentPlan[]

  @@unique([orgId, cardId])
  @@index([orgId, sortOrder, id])
  @@index([styleId])
  @@index([workOrderId])
  @@index([buyerOrgId])
}
