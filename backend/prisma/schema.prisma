// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrganizationType {
  MANUFACTURER
  BRAND
}

enum OrgUserRole {
  ADMIN
  OPERATOR
  ACCOUNTANT
  WORKER
}

enum OrgMembershipStatus {
  PENDING
  ACTIVE
  REJECTED
  SUSPENDED
  TERMINATED
}

enum OrganizationSubscriptionStatus {
  NOT_SUBSCRIBED
  TRIAL
  ACTIVE
  GRACE
  SUSPENDED
}

enum SystemRole {
  SYSTEM_ADMIN
  USER
}

model SystemUser {
  id         Int        @id @default(autoincrement())
  email      String     @unique
  systemRole SystemRole @default(USER)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
}

model Organization {
  id             Int              @id @default(autoincrement())
  name           String
  code           String?          @unique
  businessNumber String?
  representative String?
  industry       String?
  address        String?
  phone          String?
  email          String?
  type           OrganizationType @default(MANUFACTURER)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  colors     AttrColor[]
  categories AttrCategory[]
  roles      AttrRole[]
  processes  AttrProcess[]
  subscription OrganizationSubscription?
  memberships OrgMembership[]
  factories  Factory[]
  employees  Employee[]
  lines      Line[]
  styles     Style[]
  orders     WorkOrder[]
  workLogs   WorkLog[]
  workRecords WorkRecord[]
  assignmentBoardState AssignmentBoardState?
  assignmentPlans AssignmentPlan[]
  manufacturerRelationships OrgRelationship[] @relation("ManufacturerOrgRelationships")
  brandRelationships OrgRelationship[] @relation("BrandOrgRelationships")
}

model OrganizationSubscription {
  id              Int                            @id @default(autoincrement())
  orgId           Int                            @unique
  status          OrganizationSubscriptionStatus @default(NOT_SUBSCRIBED)
  membershipEmail String?
  billingEmail    String?
  trialStartedAt  DateTime?
  trialEndsAt     DateTime?
  activatedAt     DateTime?
  suspendedAt     DateTime?
  createdAt       DateTime                       @default(now())
  updatedAt       DateTime                       @updatedAt

  organization Organization @relation(fields: [orgId], references: [id])

  @@index([status])
}

model OrgMembership {
  id        Int         @id @default(autoincrement())
  orgId     Int
  email     String
  role      OrgUserRole @default(OPERATOR)
  status    OrgMembershipStatus @default(ACTIVE)
  requestedAt DateTime?
  approvedAt DateTime?
  approvedBy String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  organization Organization @relation(fields: [orgId], references: [id])
  employee     Employee?

  @@unique([orgId, email])
  @@index([orgId])
  @@index([email])
  @@index([status])
  @@index([orgId, status])
}

model Factory {
  id               Int      @id @default(autoincrement())
  orgId            Int
  name             String
  address          String?
  countryCode      String?
  phoneNumber      String?
  manager          String?
  targetMonthlyWage Float?
  wagePerSecond    Float?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  organization Organization @relation(fields: [orgId], references: [id])
  employees    Employee[]
  lines        Line[]

  @@index([orgId])
}

model Line {
  id                Int      @id @default(autoincrement())
  orgId             Int
  factoryId         Int
  name              String
  managerEmployeeId Int?
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  organization Organization @relation(fields: [orgId], references: [id])
  factory      Factory      @relation(fields: [factoryId], references: [id])
  manager      Employee?    @relation("LineManager", fields: [managerEmployeeId], references: [id])
  assignments  LineAssignment[]
  assignmentPlans AssignmentPlan[]

  @@index([orgId])
  @@index([factoryId])
  @@unique([factoryId, name])
}

model Employee {
  id        Int      @id @default(autoincrement())
  orgId     Int
  orgMembershipId Int      @unique
  factoryId Int?
  roleId    Int?
  name      String?
  bankName  String?
  bankAccountNumber String?
  lineName  String?
  position  String?
  joinedAt  DateTime?
  leftAt    DateTime?
  leaveStartAt DateTime?
  leaveEndAt   DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization   @relation(fields: [orgId], references: [id])
  membership   OrgMembership @relation(fields: [orgMembershipId], references: [id])
  factory      Factory?        @relation(fields: [factoryId], references: [id])
  role         AttrRole?       @relation(fields: [roleId], references: [id])
  lineAssignments LineAssignment[]
  managedLines   Line[] @relation("LineManager")

  @@index([orgId])
  @@index([factoryId])
  @@index([roleId])
}

model LineAssignment {
  id         Int      @id @default(autoincrement())
  lineId     Int
  employeeId Int
  startAt    DateTime @default(now())
  endAt      DateTime?

  line     Line     @relation(fields: [lineId], references: [id])
  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([lineId])
  @@index([employeeId])
  @@index([endAt])
}

model OrgRelationship {
  id                Int      @id @default(autoincrement())
  manufacturerOrgId Int
  brandOrgId        Int
  customerCode      String?
  managerName       String?
  managerPhone      String?
  managerEmail      String?
  memo              String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  manufacturer Organization @relation("ManufacturerOrgRelationships", fields: [manufacturerOrgId], references: [id])
  brand         Organization @relation("BrandOrgRelationships", fields: [brandOrgId], references: [id])

  @@unique([manufacturerOrgId, brandOrgId])
  @@index([manufacturerOrgId])
  @@index([brandOrgId])
}

model AttrColor {
  id    Int    @id @default(autoincrement())
  orgId Int
  code  String
  name  String

  organization Organization @relation(fields: [orgId], references: [id])

  @@unique([orgId, code])
  @@index([orgId])
}

model AttrCategory {
  id    Int    @id @default(autoincrement())
  orgId Int
  code  String
  name  String

  organization Organization @relation(fields: [orgId], references: [id])

  @@unique([orgId, code])
  @@index([orgId])
}

model AttrRole {
  id    Int    @id @default(autoincrement())
  orgId Int
  code  String
  name  String

  organization Organization @relation(fields: [orgId], references: [id])
  employees    Employee[]

  @@unique([orgId, code])
  @@index([orgId])
}

model AttrProcess {
  id    Int    @id @default(autoincrement())
  orgId Int
  code  String
  name  String

  organization Organization @relation(fields: [orgId], references: [id])

  @@unique([orgId, code])
  @@index([orgId])
}

model Style {
  uid              Int      @id @default(autoincrement())
  orgId            Int
  styleId          String
  styleCode        String
  name             String
  customer         String
  registrationDate String?
  designer         String?
  collection       String?
  season           String?
  imageUrls        Json?
  processes        Json?
  bom              Json?
  bomNotes         String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  organization Organization @relation(fields: [orgId], references: [id])

  @@unique([orgId, styleId])
  @@unique([orgId, customer, name])
  @@unique([orgId, customer, styleCode])
  @@index([orgId])
}

model WorkOrder {
  id           Int      @id @default(autoincrement())
  orgId        Int
  orderId      String
  orderNumber  String
  buyerOrgId   Int?
  buyerOrgName String?
  sellerOrgId  Int?
  sellerOrgName String?
  customerId   Int?
  customerName String?
  dueDate      String?
  status       String
  items        Json?
  totalQuantity Int     @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  organization Organization @relation(fields: [orgId], references: [id])

  @@unique([orgId, orderId])
  @@unique([orgId, customerId, orderNumber])
  @@unique([buyerOrgId, sellerOrgId, orderNumber])
  @@index([orgId])
  @@index([orgId, orderNumber])
}

model AssignmentPlan {
  id                    Int      @id @default(autoincrement())
  orgId                 Int
  lineId                Int
  externalId            String
  cardId                String?
  orderNo               String?
  customer              String?
  label                 String?
  colorName             String?
  previewUrl            String?
  imageUrl              String?
  thumbnailUrl          String?
  quantity              Int?
  originOrderId         String?
  basis                 String?
  proposalBasis         String?
  proposalSeconds       Int?
  contractedSeconds     Int?
  ctStatus              String   @default("PENDING")
  ctSource              String?
  ctAgreedBy            String?
  ctAgreedAt            DateTime?
  ctNote                String?
  color                 String?
  stripeColor           String?
  totalSeconds          Int?
  startIndex            Int
  endIndex              Int
  startDayOffsetPercent Float?
  startDayPercent       Float?
  endDayPercent         Float?
  createdAt             DateTime @default(now())
  updatedAt             DateTime

  line         Line         @relation(fields: [lineId], references: [id])
  organization Organization @relation(fields: [orgId], references: [id])

  @@unique([orgId, externalId])
  @@index([orgId, lineId])
}

model WorkLog {
  id                     Int      @id @default(autoincrement())
  orgId                  Int
  workDate               String
  factoryId              Int?
  factoryName            String?
  factoryWagePerSecond   Float?
  ctBasis                String   @default("CT")
  workerCount            Int      @default(0)
  itemCount              Int      @default(0)
  totalContractedSeconds Int      @default(0)
  note                   String?
  records                Json?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  organization Organization @relation(fields: [orgId], references: [id])
  workRecords  WorkRecord[]

  @@index([orgId, workDate])
  @@index([orgId, createdAt])
}

model WorkRecord {
  id           Int      @id @default(autoincrement())
  orgId        Int
  workLogId    Int
  workerId     Int?
  workerName   String?
  customerName String?
  styleId      String?
  styleName    String?
  processCode  String?
  processName  String?
  colorId      Int?
  colorCode    String?
  colorName    String?
  ctSeconds    Int      @default(0)
  quantity     Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  organization Organization @relation(fields: [orgId], references: [id])
  workLog      WorkLog      @relation(fields: [workLogId], references: [id], onDelete: Cascade)

  @@index([orgId, workLogId])
  @@index([orgId, workerId])
  @@index([orgId, styleId])
  @@index([workLogId])
}

model AssignmentBoardState {
  id          Int      @id @default(autoincrement())
  orgId       Int      @unique
  cards       Json?
  assignments Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  organization Organization @relation(fields: [orgId], references: [id])

  @@index([orgId])
}
