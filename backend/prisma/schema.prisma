  updatedByEmployeeId Int?
  updatedAt           DateTime              @updatedAt

  organization   Organization   @relation(fields: [orgId], references: [id])
  assignmentPlan AssignmentPlan @relation(fields: [assignmentPlanId], references: [id], onDelete: Cascade)
  attrColor      AttrColor?     @relation(fields: [colorId], references: [id], onDelete: SetNull)

  createdByEmployee Employee? @relation("QcPassEventCreatedByEmployee", fields: [createdByEmployeeId], references: [id], onDelete: SetNull)
  updatedByEmployee Employee? @relation("QcPassEventUpdatedByEmployee", fields: [updatedByEmployeeId], references: [id], onDelete: SetNull)

