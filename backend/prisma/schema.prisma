  orgId                     Int
  lineId                    Int
  externalId                String
  cardId                    String?
  assignmentCardId          Int?
  workOrderId               Int?
  styleId                   Int?
  // Real FK replacing the "customer" string copy (AssignmentCard/AssignmentPlan
  // FK+join redesign, Phase A). Named buyerOrgId (not customerId) to match
  // WorkOrder's own naming - the ordering party (buyer org), same as
  // WorkOrder.buyerOrgId. Backfilled via assignmentCardId -> AssignmentCard.buyerOrgId.
  buyerOrgId                Int?
  orgRelationshipId         Int?
  // orderNo/customer/label/previewUrl were dropped in Phase E (AssignmentCard/
  // AssignmentPlan FK+join redesign) - all four are fully derivable through
  // workOrderId/styleId/buyerOrgId (workOrder.orderNumber, style.name,
  // buyerOrg.name, style.imageUrls[0]), so keeping them as separate text
  // columns was pure duplication once those FKs existed. See toAssignmentPlanResponse.
  assignmentQuantity        Int?
  originOrderId             String?
  basis                     String?
  assignmentCtTotalSeconds  Int?
  assignmentCtSnapshot      Json?
  assignmentStTotalSeconds  Int?
  assignmentStSnapshot      Json?
  ctReviewRequired          Boolean               @default(false)
  ctReviewedAt              DateTime?
  ctReviewedByEmployeeId    Int?
  startIndex                Int
  endIndex                  Int
  startDayOffsetPercent     Float?
  startDayPercent           Float?
  endDayPercent             Float?
  isCompleted               Boolean               @default(false)
  finalQuantity             Int?
  completedAt               DateTime?
  productionCompletedAt     DateTime?
  actualProducedCompletedAt DateTime?
  candidateEndDate          DateTime?
  renderEndDate             DateTime?
  forecastCompletedAt       DateTime?
  forecastBasis             String?
  confidence                String?
  scheduleStatus            String?
  qcPassedTotal             Int                   @default(0)
  latestQcDate              String?
  closedQty                 Int?
  closedAt                  DateTime?
  closedBy                  String?
  closeMode                 AssignmentCloseMode?
  closeBasis                AssignmentCloseBasis?
  createdAt                 DateTime              @default(now())
  createdBy                 String                @default("system@baro.local")
  createdByEmployeeId       Int?
  updatedByEmployeeId       Int?
  updatedAt                 DateTime              @updatedAt

  line                    Line                        @relation(fields: [lineId], references: [id], onDelete: Restrict)
  organization            Organization                @relation(fields: [orgId], references: [id])
  workOrder               WorkOrder?                  @relation(fields: [workOrderId], references: [id], onDelete: SetNull)
  style                   Style?                      @relation(fields: [styleId], references: [id], onDelete: SetNull)
  buyerOrg                Organization?               @relation("AssignmentPlanBuyerOrg", fields: [buyerOrgId], references: [id], onDelete: SetNull)
  orgRelationship         OrgRelationship?            @relation(fields: [orgRelationshipId, orgId, buyerOrgId], references: [id, manufacturerOrgId, brandOrgId], onDelete: Restrict, map: "AssignmentPlan_relationship_scope_fkey")
  // Real FK replacing the old "cardId string happens to match" convention
  // (AGENTS.md structural-problems list). cardId itself is kept as the stable
  // external board identifier; joins must use assignmentCardId/workOrderId/styleId.
  assignmentCard          AssignmentCard?             @relation(fields: [assignmentCardId], references: [id], onDelete: SetNull)
  workRecords             WorkRecord[]
  qcPassEvents            QcPassEvent[]
  trainingBucketProcesses AtTrainingBucketProcess[]
  atObservations          StyleProcessAtObservation[]

