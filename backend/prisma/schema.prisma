  id                         Int      @id @default(autoincrement())
  orgId                      Int
  workLogId                  Int
  workerId                   Int?
  lineId                     Int?
  styleId                    Int
  styleProcessId             Int
  assignmentPlanId           Int
  effectiveCoverageStartDate String?
  effectiveCoverageEndDate   String?
  ctSeconds                  Int      @default(0)
  quantity                   Int      @default(0)
  createdAt                  DateTime @default(now())
  createdBy                  String   @default("system@baro.local")
  createdByEmployeeId        Int?
  updatedByEmployeeId        Int?
  updatedAt                  DateTime @updatedAt

  organization   Organization   @relation(fields: [orgId], references: [id])
  workLog        WorkLog        @relation(fields: [workLogId], references: [id], onDelete: Cascade)
  worker         Employee?      @relation(fields: [workerId], references: [id], onDelete: SetNull)
  assignmentPlan AssignmentPlan @relation(fields: [assignmentPlanId, orgId], references: [id, orgId], onDelete: Restrict, map: "WorkRecord_assignmentPlan_org_fkey")
  style          Style          @relation(fields: [styleId], references: [id], onDelete: Restrict)
  styleProcess   StyleProcess   @relation(fields: [styleProcessId, styleId, orgId], references: [id, styleId, orgId], onDelete: Restrict, map: "WorkRecord_styleProcess_style_org_fkey")
  line           Line?          @relation("WorkRecordLine", fields: [lineId], references: [id], onDelete: SetNull)

  createdByEmployee Employee? @relation("WorkRecordCreatedByEmployee", fields: [createdByEmployeeId], references: [id], onDelete: SetNull)
  updatedByEmployee Employee? @relation("WorkRecordUpdatedByEmployee", fields: [updatedByEmployeeId], references: [id], onDelete: SetNull)

  @@index([orgId, workLogId])
  @@index([orgId, workerId])
  @@index([orgId, styleId])
  @@index([orgId, lineId])
  @@index([styleProcessId])
  @@index([assignmentPlanId])
  @@index([workLogId])
}

model PayrollSnapshot {
  id                  Int      @id @default(autoincrement())
  orgId               Int
  month               String
  data                Json
  lockedAt            DateTime
  lockedBy            String
  isProvisional       Boolean  @default(false)
  createdAt           DateTime @default(now())
  createdBy           String   @default("system@baro.local")
  createdByEmployeeId Int?
  updatedByEmployeeId Int?

  organization Organization @relation(fields: [orgId], references: [id])

  createdByEmployee Employee? @relation("PayrollSnapshotCreatedByEmployee", fields: [createdByEmployeeId], references: [id], onDelete: SetNull)
  updatedByEmployee Employee? @relation("PayrollSnapshotUpdatedByEmployee", fields: [updatedByEmployeeId], references: [id], onDelete: SetNull)

  @@unique([orgId, month])
  @@index([orgId])
}

model QuantitySettlementSnapshot {
  id                  Int      @id @default(autoincrement())
  orgId               Int
  month               String
  data                Json
  createdAt           DateTime @default(now())
  createdBy           String   @default("system@baro.local")
  createdByEmployeeId Int?
  updatedByEmployeeId Int?
  updatedAt           DateTime @updatedAt
  updatedBy           String   @default("system@baro.local")

  organization Organization @relation(fields: [orgId], references: [id])

  createdByEmployee Employee? @relation("QuantitySettlementSnapshotCreatedByEmployee", fields: [createdByEmployeeId], references: [id], onDelete: SetNull)
  updatedByEmployee Employee? @relation("QuantitySettlementSnapshotUpdatedByEmployee", fields: [updatedByEmployeeId], references: [id], onDelete: SetNull)

  @@unique([orgId, month])
  @@index([orgId])
}

model AssignmentBoardState {
  id                  Int      @id @default(autoincrement())
  orgId               Int      @unique
  /// Deprecated board payload mirror. AssignmentCard is the canonical card store.
  cards               Json?
  /// Deprecated board payload mirror. AssignmentPlan is the canonical assignment store.
  assignments         Json?
  createdAt           DateTime @default(now())
  createdBy           String   @default("system@baro.local")
  createdByEmployeeId Int?
  updatedByEmployeeId Int?
  updatedAt           DateTime @updatedAt

  organization Organization @relation(fields: [orgId], references: [id])

  createdByEmployee Employee? @relation("AssignmentBoardStateCreatedByEmployee", fields: [createdByEmployeeId], references: [id], onDelete: SetNull)
  updatedByEmployee Employee? @relation("AssignmentBoardStateUpdatedByEmployee", fields: [updatedByEmployeeId], references: [id], onDelete: SetNull)

  @@index([orgId])
}

model AssignmentCard {
  id                  Int      @id @default(autoincrement())
  orgId               Int
  cardId              String
  sortOrder           Int      @default(0)
  payload             Json
  createdAt           DateTime @default(now())
  createdBy           String   @default("system@baro.local")
  createdByEmployeeId Int?
  updatedByEmployeeId Int?
  updatedAt           DateTime @updatedAt

  // Real FK columns replacing the "payload JSON happens to carry these
  // ints/strings" convention (AGENTS.md AssignmentCard/AssignmentPlan
  // FK+join redesign, Phase A). payload must not be used as the source for
  // these relations.
  styleId     Int?
  workOrderId Int?
  buyerOrgId  Int?

  organization    Organization     @relation(fields: [orgId], references: [id])
  style           Style?           @relation(fields: [styleId], references: [id], onDelete: SetNull)
  workOrder       WorkOrder?       @relation(fields: [workOrderId], references: [id], onDelete: SetNull)
  buyerOrg        Organization?    @relation("AssignmentCardBuyerOrg", fields: [buyerOrgId], references: [id], onDelete: SetNull)
  assignmentPlans AssignmentPlan[]

  createdByEmployee Employee? @relation("AssignmentCardCreatedByEmployee", fields: [createdByEmployeeId], references: [id], onDelete: SetNull)
  updatedByEmployee Employee? @relation("AssignmentCardUpdatedByEmployee", fields: [updatedByEmployeeId], references: [id], onDelete: SetNull)

  @@unique([orgId, cardId])
  @@index([orgId, sortOrder, id])
  @@index([styleId])
  @@index([workOrderId])
  @@index([buyerOrgId])
}
