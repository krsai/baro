// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrganizationType {
  MANUFACTURER
  BRAND
  BOTH
}

enum OrgUserRole {
  ADMIN
  OPERATOR
  ACCOUNTANT
  WORKER
}

enum OrgMembershipStatus {
  PENDING
  ACTIVE
  REJECTED
  SUSPENDED
  TERMINATED
}

enum SystemRole {
  SYSTEM_ADMIN
  USER
}

model SystemUser {
  id         Int        @id @default(autoincrement())
  email      String     @unique
  systemRole SystemRole @default(USER)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
}

model Organization {
  id             Int              @id @default(autoincrement())
  name           String
  businessNumber String?
  representative String?
  industry       String?
  address        String?
  phone          String?
  email          String?
  type           OrganizationType @default(MANUFACTURER)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  colors     AttrColor[]
  sizes      AttrSize[]
  genders    AttrGender[]
  categories AttrCategory[]
  roles      AttrRole[]
  processes  AttrProcess[]
  members    OrganizationUser[]
  factories  Factory[]
  employees  Employee[]
}

model OrganizationUser {
  id        Int         @id @default(autoincrement())
  orgId     Int
  email     String
  role      OrgUserRole @default(OPERATOR)
  status    OrgMembershipStatus @default(ACTIVE)
  requestedAt DateTime?
  approvedAt DateTime?
  approvedBy String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  organization Organization @relation(fields: [orgId], references: [id])
  employee     Employee?

  @@unique([orgId, email])
  @@index([orgId])
  @@index([email])
}

model Factory {
  id               Int      @id @default(autoincrement())
  orgId            Int
  name             String
  address          String?
  countryCode      String?
  phoneNumber      String?
  manager          String?
  wageStandard      String  @default("PT")
  targetMonthlyWage Float?
  wagePerSecond    Float?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  organization Organization @relation(fields: [orgId], references: [id])
  employees    Employee[]

  @@index([orgId])
}

model Employee {
  id        Int      @id @default(autoincrement())
  orgId     Int
  orgUserId Int      @unique
  factoryId Int?
  roleId    Int?
  lineName  String?
  position  String?
  joinedAt  DateTime?
  leftAt    DateTime?
  leaveStartAt DateTime?
  leaveEndAt   DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization   @relation(fields: [orgId], references: [id])
  membership   OrganizationUser @relation(fields: [orgUserId], references: [id])
  factory      Factory?        @relation(fields: [factoryId], references: [id])
  role         AttrRole?       @relation(fields: [roleId], references: [id])

  @@index([orgId])
  @@index([factoryId])
  @@index([roleId])
}

model AttrColor {
  id    Int    @id @default(autoincrement())
  orgId Int
  code  String
  name  String

  organization Organization @relation(fields: [orgId], references: [id])

  @@unique([orgId, code])
  @@index([orgId])
}

model AttrSize {
  id    Int    @id @default(autoincrement())
  orgId Int
  code  String
  name  String

  organization Organization @relation(fields: [orgId], references: [id])

  @@unique([orgId, code])
  @@index([orgId])
}

model AttrGender {
  id    Int    @id @default(autoincrement())
  orgId Int
  code  String
  name  String

  organization Organization @relation(fields: [orgId], references: [id])

  @@unique([orgId, code])
  @@index([orgId])
}

model AttrCategory {
  id    Int    @id @default(autoincrement())
  orgId Int
  code  String
  name  String

  organization Organization @relation(fields: [orgId], references: [id])

  @@unique([orgId, code])
  @@index([orgId])
}

model AttrRole {
  id    Int    @id @default(autoincrement())
  orgId Int
  code  String
  name  String

  organization Organization @relation(fields: [orgId], references: [id])
  employees    Employee[]

  @@unique([orgId, code])
  @@index([orgId])
}

model AttrProcess {
  id    Int    @id @default(autoincrement())
  orgId Int
  code  String
  name  String

  organization Organization @relation(fields: [orgId], references: [id])

  @@unique([orgId, code])
  @@index([orgId])
}
