{
  "name": "backend",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "prisma:prepare-client": "npx prisma generate && npm run prisma:fix-entry",
    "prisma:fix-entry": "node scripts/fix-prisma-client-entry.js",
    "postinstall": "npm run prisma:prepare-client",
    "preseed:test-accounts": "npm run prisma:prepare-client",
    "seed:test-accounts": "node scripts/seed-test-accounts.js",
    "predev": "npm run prisma:prepare-client",
    "prestart": "npm run prisma:prepare-client && npm run build",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "repair:assignment-text": "node scripts/repair-assignment-text.js"
  },
