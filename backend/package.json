    "prisma": "^6.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.2.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3"
  }
