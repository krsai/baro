{
  "name": "backend",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "prisma:prepare-client": "node scripts/run-prisma.js generate && npm run prisma:fix-entry",
    "prisma:migrate:deploy": "node scripts/run-prisma.js migrate deploy",
    "prisma:deploy:safe": "node scripts/prisma-safe-deploy.js",
    "prisma:apply:migration-fix": "node scripts/run-prisma.js db execute --schema ./prisma/schema.prisma --file ./migration_fix.sql",
    "railway:predeploy": "npm run prisma:prepare-client && npm run prisma:apply:migration-fix && npm run prisma:deploy:safe",
    "railway:startup": "npm run prisma:apply:migration-fix && npm run prisma:deploy:safe",
    "prisma:fix-entry": "node scripts/fix-prisma-client-entry.js",
    "postinstall": "npm run prisma:prepare-client",
    "prereset:baseline": "npm run prisma:prepare-client",
    "initialize": "node scripts/reset-to-baseline.js initialize",
    "reset:baseline": "node scripts/reset-to-baseline.js",
    "sample:orders": "node scripts/reset-to-baseline.js orders",
    "sample:work-logs": "node scripts/reset-to-baseline.js work-logs",
    "predev": "npm run prisma:prepare-client && npm run prisma:deploy:safe && npm run prisma:fix-entry",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "start:api": "node dist/index.js",
    "repair:assignment-text": "node scripts/repair-assignment-text.js",
    "repair:assignment-schedule": "node scripts/repair-assignment-schedule.js",
    "repair:assignment-statuses": "node scripts/repair-assignment-statuses.js",
    "repair:assignment-st-snapshots": "node scripts/repair-assignment-st-snapshots.js",
    "workrecord:inspect": "node scripts/inspect-workrecord-state.js",
    "verify:workorder-item-backfill": "node scripts/verify-workorder-item-backfill.js",
    "verify:style-process-backfill": "node scripts/verify-style-process-backfill.js",
    "verify:assignment-board-state-backfill": "node scripts/verify-assignment-board-state-backfill.js",
    "verify:relational-integrity": "npm run build && node scripts/verify-relational-integrity.js",
    "verify:st-bucket-fk": "node scripts/inspect-st-bucket-fk-readiness.js",
    "verify:at-v2-shadow": "node scripts/verify-at-v2-shadow.js",
    "test:work-record-employment": "npm run build && node scripts/test-work-record-employment.js",
    "realign:time-model": "node scripts/reset-to-baseline.js time-model",
    "backfill:missing-attendance": "node scripts/backfill-missing-attendance.js",
    "process-master:cleanup-duplicates": "node scripts/cleanup-process-master-duplicates.js",
    "process-master:cleanup-duplicates:apply": "node scripts/cleanup-process-master-duplicates.js --apply",
    "process-master:clear-specs": "node scripts/clear-process-master-specs.js",
    "process-master:clear-specs:apply": "node scripts/clear-process-master-specs.js --apply"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@prisma/client": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.2.4",
    "express": "^5.2.1",
    "jose": "^6.2.3",
    "prisma": "^6.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.2.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3"
  }
}
