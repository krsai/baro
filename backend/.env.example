# BARO application data uses Railway Postgres only. Never use Supabase Postgres here.
DATABASE_URL=postgresql://USER:PASSWORD@RAILWAY_HOST:5432/DB_NAME?schema=public
DIRECT_URL=postgresql://USER:PASSWORD@RAILWAY_HOST:5432/DB_NAME?schema=public
PORT=4000
BUSINESS_TIME_ZONE=Asia/Seoul
WORK_LOG_ASSIGNMENT_PROCESS_QTY_MAX_MULTIPLIER=3
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SYSTEM_ADMIN_EMAIL=admin@example.com

# Optional NAS evidence storage. Empty keeps uploads disabled; legacy evidence paths still work.
# Server secret only. Keys are actual Organization IDs, never company names or client input.
# Each company needs a distinct HTTPS WebDAV shared-folder URL (ending /) and account.
# Shape: {"ORG_ID":{"baseUrl":"https://NAS_HOST/COMPANY_EVIDENCE/","username":"APP_ACCOUNT","password":"SECRET"}}
# Do not commit real endpoints or credentials. Create the shared folders and permissions on NAS first.
EVIDENCE_NAS_COMPANIES_JSON={}
