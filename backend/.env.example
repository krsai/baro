# BARO application data uses Railway Postgres only. Never use Supabase Postgres here.
DATABASE_URL=postgresql://USER:PASSWORD@RAILWAY_HOST:5432/DB_NAME?schema=public
DIRECT_URL=postgresql://USER:PASSWORD@RAILWAY_HOST:5432/DB_NAME?schema=public
PORT=4000
BUSINESS_TIME_ZONE=Asia/Seoul
WORK_LOG_ASSIGNMENT_PROCESS_QTY_MAX_MULTIPLIER=3
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SYSTEM_ADMIN_EMAIL=admin@example.com
AT_DISPLAY_MODEL_VERSION=v1
